FRONTEND_PORT=8088
BACKEND_PORT=18080
POSTGRES_DB=coffee_shop
POSTGRES_USER=coffee_shop
POSTGRES_PASSWORD=coffee_shop_local

# Local Keycloak only. `node scripts/keycloak-local.mjs up` generates blank secrets.
KEYCLOAK_PORT=8180
KEYCLOAK_ENABLED=false
PUBLIC_APP_URL=http://localhost:8088
KEYCLOAK_ISSUER=http://localhost:8180/realms/coffee-shop
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/coffee-shop
KEYCLOAK_CLIENT_ID=coffee-shop
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Order confirmations use Mailpit locally and SMTP settings in production.
ORDER_CONFIRMATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true